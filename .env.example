# ── API (@vigie/api) ────────────────────────────────────────────
PORT=3001
DATABASE_URL=postgres://vigie:vigie@localhost:5432/vigie
APP_BASE_URL=http://localhost:3000

# Emails (Resend). Absent = les emails sont loggés en console.
RESEND_API_KEY=
EMAIL_FROM="Vigie <alertes@vigie.app>"

# Diagnostic (Claude Agent SDK + skill claude-seo)
ANTHROPIC_API_KEY=
DIAGNOSTIC_WORKSPACE=./infra/diagnostic-workspace
ARTIFACTS_DIR=/var/lib/vigie/artifacts

# Stripe (abonnements Garde + crédits Diagnostic)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduler (cron hebdo + quotidien)
CRON_ENABLED=true

# ── Web (apps/web) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── API (@vigie/api) ────────────────────────────────────────────
PORT=3001
DATABASE_URL=postgres://vigie:vigie@localhost:5432/vigie
APP_BASE_URL=http://localhost:3000

# Emails (Resend). Absent = les emails sont loggés en console.
RESEND_API_KEY=
EMAIL_FROM="Vigie <alertes@vigie.app>"

# Diagnostic — moteur IA
# LLM_PROVIDER : anthropic (défaut) | xai (Grok) | openai-compatible
#   (tout endpoint /chat/completions ; LLM_BASE_URL et LLM_MODEL requis).
# LLM_MODE : agent-sdk (audit agentique : l'agent navigue lui-même — Anthropic,
#   ou xAI via son endpoint compatible Anthropic) | chat (notre crawler
#   collecte, le LLM analyse). Vide = défaut du provider (anthropic →
#   agent-sdk, xai → chat). Provider ET mode surchargeables par job via
#   POST /sites/:id/diagnostic {"provider": "xai", "mode": "agent-sdk"}.
LLM_PROVIDER=anthropic
LLM_MODE=
ANTHROPIC_API_KEY=
XAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
# Endpoint Anthropic-compatible pour le mode agent-sdk hors Anthropic
# (défaut xai : https://api.x.ai).
LLM_AGENT_BASE_URL=
LLM_MODEL=
# Coûts par million de tokens pour l'instrumentation (mode chat).
LLM_COST_PER_MTOK_INPUT_USD=0
LLM_COST_PER_MTOK_OUTPUT_USD=0
DIAGNOSTIC_WORKSPACE=./infra/diagnostic-workspace
ARTIFACTS_DIR=/var/lib/vigie/artifacts

# Stripe (abonnements Garde + crédits Diagnostic)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduler (cron hebdo + quotidien)
CRON_ENABLED=true

# ── Web (apps/web) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

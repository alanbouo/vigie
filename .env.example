# ── API (@vigie/api) ────────────────────────────────────────────
PORT=3001
DATABASE_URL=postgres://vigie:vigie@localhost:5432/vigie
APP_BASE_URL=http://localhost:3000

# Emails (Resend). Absent = les emails sont loggés en console.
RESEND_API_KEY=
EMAIL_FROM="Vigie <alertes@vigie.app>"

# Diagnostic — moteur IA
# LLM_PROVIDER : anthropic (défaut, Agent SDK + skill claude-seo, audit
# agentique) | xai (Grok, mode chat sur données du crawler) |
# openai-compatible (tout endpoint /chat/completions ; LLM_BASE_URL et
# LLM_MODEL requis). Surchargeable par job via POST /sites/:id/diagnostic.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
XAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Coûts par million de tokens pour l'instrumentation (mode chat).
LLM_COST_PER_MTOK_INPUT_USD=0
LLM_COST_PER_MTOK_OUTPUT_USD=0
DIAGNOSTIC_WORKSPACE=./infra/diagnostic-workspace
ARTIFACTS_DIR=/var/lib/vigie/artifacts

# Stripe (abonnements Garde + crédits Diagnostic)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduler (cron hebdo + quotidien)
CRON_ENABLED=true

# ── Web (apps/web) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
